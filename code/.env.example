# Optional OpenRouter hybrid mode only. The tuned offline pipeline does not require secrets.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_MAX_REQUESTS=35
OPENROUTER_TIMEOUT_SECONDS=40
OPENROUTER_MAX_RETRIES=1
OPENROUTER_MAX_TEXT_ENRICHMENTS=12

# Local voice transcription; no paid transcription endpoint is used.
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_LOCAL_FILES_ONLY=1
LOCAL_WHISPER_ALLOW_MODEL_FALLBACK=1
